# Adresse publique définitive du site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=

# Formulaire de contact (Resend) — les trois sont nécessaires
RESEND_API_KEY=
CONTACT_TO_EMAIL=martin.bourasseau4@gmail.com
CONTACT_FROM_EMAIL=

# Forcer l'indexation hors production Vercel (laisser vide)
NEXT_PUBLIC_ALLOW_INDEXING=

# Bloquer l'indexation, même en production, jusqu'à la publication officielle
NEXT_PUBLIC_NOINDEX=true
